<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="res_groups_privilege_hms" model="res.groups.privilege">
        <field name="name">HMS</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_hms_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_hms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hms_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_hms"/>
        <field name="implied_ids" eval="[(4, ref('group_hms_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_hms_patient_user_own" model="ir.rule">
        <field name="name">HMS users can access own patients</field>
        <field name="model_id" ref="model_hms_patient"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hms_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hms_patient_manager_all" model="ir.rule">
        <field name="name">HMS managers can access all patients</field>
        <field name="model_id" ref="model_hms_patient"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hms_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_hms_patient_log_user_own" model="ir.rule">
        <field name="name">HMS users can access own patient logs</field>
        <field name="model_id" ref="model_hms_patient_log"/>
        <field name="domain_force">[('patient_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hms_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hms_patient_log_manager_all" model="ir.rule">
        <field name="name">HMS managers can access all patient logs</field>
        <field name="model_id" ref="model_hms_patient_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hms_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
