<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="action_report_hms_patient_status" model="ir.actions.report">
        <field name="name">HMS Patient Status Report</field>
        <field name="model">hms.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hms.report_hms_patient_status</field>
        <field name="report_file">hms.report_hms_patient_status</field>
        <field name="binding_model_id" ref="model_hms_patient"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hms_patient_status">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="patient">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">HMS Patient Status Report</h2>

                        <table class="table table-sm table-borderless mt-4">
                            <tbody>
                                <tr>
                                    <td><strong>Name:</strong></td>
                                    <td>
                                        <span t-esc="'%s %s' % (patient.first_name or '', patient.last_name or '')"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Age:</strong></td>
                                    <td><span t-field="patient.age"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Department:</strong></td>
                                    <td><span t-field="patient.department_id"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Doctors:</strong></td>
                                    <td>
                                        <span t-esc="', '.join(patient.doctor_ids.mapped('display_name'))"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Birth date:</strong></td>
                                    <td><span t-field="patient.birth_date"/></td>
                                </tr>
                                <tr>
                                    <td><strong>PCR:</strong></td>
                                    <td><span t-field="patient.cr_ratio"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Blood Type:</strong></td>
                                    <td><span t-field="patient.blood_type"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Email:</strong></td>
                                    <td><span t-field="patient.email"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Log History</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Date</th>
                                    <th>Info</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="patient.log_ids" t-as="log">
                                    <td><span t-field="log.created_by"/></td>
                                    <td><span t-field="log.date"/></td>
                                    <td><span t-field="log.description"/></td>
                                </tr>
                                <tr t-if="not patient.log_ids">
                                    <td colspan="3" class="text-center">No log history</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
